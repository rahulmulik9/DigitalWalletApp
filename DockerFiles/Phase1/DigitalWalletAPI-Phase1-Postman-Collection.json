{
  "info": {
    "_postman_id": "digital-wallet-rahul",
    "name": "DigitalWalletAPI",
    "description": "Postman collection for the DigitalWallet Spring Boot application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "walletId",
      "value": "1"
    },
    {
      "key": "fromWalletId",
      "value": "1"
    },
    {
      "key": "toWalletId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Phase 1",
      "item": [
        {
          "name": "Users",
          "item": [
            {
              "name": "Register User",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/users/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "register"
                  ]
                }
              }
            },
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"rahul@gmail.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/users/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "login"
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Wallets",
          "item": [
            {
              "name": "Get Wallet",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "wallets",
                    "{{walletId}}"
                  ]
                }
              }
            },
            {
              "name": "Deposit",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 500\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}/deposit",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "wallets",
                    "{{walletId}}",
                    "deposit"
                  ]
                }
              }
            },
            {
              "name": "Withdraw",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 200\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}/withdraw",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "wallets",
                    "{{walletId}}",
                    "withdraw"
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Transfers",
          "item": [
            {
              "name": "Transfer Money",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fromWalletId\": \"{{fromWalletId}}\",\n  \"toWalletId\": \"{{toWalletId}}\",\n  \"amount\": 250\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/transfers",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "transfers"
                  ]
                }
              }
            },
            {
              "name": "Transaction History",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}/transactions?page=0&size=10",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "wallets",
                    "{{walletId}}",
                    "transactions"
                  ],
                  "query": [
                    {
                      "key": "page",
                      "value": "0"
                    },
                    {
                      "key": "size",
                      "value": "10"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  ]
}