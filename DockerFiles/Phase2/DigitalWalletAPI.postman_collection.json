{
  "info": {
    "_postman_id": "digital-wallet-rahul",
    "name": "DigitalWalletAPI",
    "description": "Postman collection for the DigitalWallet Spring Boot application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "walletId", "value": "1" },
    { "key": "otherWalletId", "value": "2" },
    { "key": "fromWalletId", "value": "1" },
    { "key": "toWalletId", "value": "2" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "adminRefreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Phase 2",
      "item": [
        {
          "name": "Users",
          "item": [
            {
              "name": "Register User",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/users/register",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "users", "register"]
                }
              }
            },
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Login successful', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "const jsonData = pm.response.json();",
                      "if (jsonData.accessToken) {",
                      "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                      "    pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                      "    console.log('Tokens saved.');",
                      "} else {",
                      "    console.warn('No accessToken in response.');",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"rahul@gmail.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/users/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "users", "login"]
                }
              }
            },
            {
              "name": "Login (Admin)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Admin login successful', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "const jsonData = pm.response.json();",
                      "if (jsonData.accessToken) {",
                      "    pm.collectionVariables.set('adminAccessToken', jsonData.accessToken);",
                      "    pm.collectionVariables.set('adminRefreshToken', jsonData.refreshToken);",
                      "    console.log('Admin tokens saved.');",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/users/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "users", "login"]
                }
              }
            },
            {
              "name": "Refresh Token (TODO — Flow D not built yet)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/refresh",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "refresh"]
                }
              }
            }
          ]
        },
        {
          "name": "Wallets",
          "item": [
            {
              "name": "Get Wallet",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "wallets", "{{walletId}}"]
                }
              }
            },
            {
              "name": "Deposit",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 500\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}/deposit",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "wallets", "{{walletId}}", "deposit"]
                }
              }
            },
            {
              "name": "Withdraw",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 200\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}/withdraw",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "wallets", "{{walletId}}", "withdraw"]
                }
              }
            }
          ]
        },
        {
          "name": "Transfers",
          "item": [
            {
              "name": "Transfer Money",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fromWalletId\": \"{{fromWalletId}}\",\n  \"toWalletId\": \"{{toWalletId}}\",\n  \"amount\": 250\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/transfers",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "transfers"]
                }
              }
            },
            {
              "name": "Transaction History",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}/transactions?page=0&size=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "wallets", "{{walletId}}", "transactions"],
                  "query": [
                    { "key": "page", "value": "0" },
                    { "key": "size", "value": "10" }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Security Checks",
          "item": [
            {
              "name": "Get Wallet — NO token (expect 401)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns 401 Unauthorized', function () {",
                      "    pm.response.to.have.status(401);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "wallets", "{{walletId}}"]
                }
              }
            },
            {
              "name": "Get Wallet — garbage token (expect 401)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns 401 Unauthorized', function () {",
                      "    pm.response.to.have.status(401);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer not-a-real-token" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{walletId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "wallets", "{{walletId}}"]
                }
              }
            },
            {
              "name": "Get Wallet — someone else's wallet (expect 403)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns 403 Forbidden', function () {",
                      "    pm.response.to.have.status(403);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{otherWalletId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "wallets", "{{otherWalletId}}"]
                }
              }
            },
            {
              "name": "Transfer FROM someone else's wallet (expect 403)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Returns 403 Forbidden', function () {",
                      "    pm.response.to.have.status(403);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{accessToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fromWalletId\": \"{{otherWalletId}}\",\n  \"toWalletId\": \"{{walletId}}\",\n  \"amount\": 50\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/transfers",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "transfers"]
                }
              }
            },
            {
              "name": "Admin — view any wallet (expect 200)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Admin can access — 200 OK', function () {",
                      "    pm.response.to.have.status(200);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/wallets/{{otherWalletId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "wallets", "{{otherWalletId}}"]
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
