{
  "info": {
    "_postman_id": "b958a125-c09d-4ac9-af72-96ca92b44bed",
    "name": "Phase 7-8(API Gateway and config server)",
    "description": "Complete Postman collection for the DigitalWallet application, updated for Phase 7. All requests now go through the API Gateway on http://localhost:8080 instead of hitting account-service (8081) or transaction-service (8082) directly. The gateway routes /api/users/**, /api/auth/**, /api/wallets/**, /api/admin/** to account-service, and /api/transactions/**, /api/transfers/**, /api/beneficiaries/** to transaction-service. Note: transaction history endpoints moved from /api/wallets/{id}/transactions to /api/transactions/wallet/{id} to remove a path collision with account-service's /api/wallets/** routes. Seeded local users: rahul@gmail.com and admin@gmail.com; both use password123. Rahul owns wallet 1; wallets 2 and 3 belong to other users.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "29215909"
  },
  "item": [
    {
      "name": "Account Service (via Gateway)",
      "item": [
        {
          "name": "User and authentication operations",
          "item": [
            {
              "name": "Register User",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fullName\": \"Postman Test User\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"password123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{gatewayUrl}}/api/users/register",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "register"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Login (Customer - Rahul)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Customer login succeeds', function () { pm.response.to.have.status(200); });",
                      "const user = pm.response.json();",
                      "pm.expect(user.accessToken).to.exist;",
                      "pm.expect(user.refreshToken).to.exist;",
                      "pm.collectionVariables.set('accessToken', user.accessToken);",
                      "pm.collectionVariables.set('refreshToken', user.refreshToken);",
                      "pm.collectionVariables.set('walletId', String(user.walletId));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"rahul@gmail.com\",\n  \"password\": \"password123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{gatewayUrl}}/api/users/login",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "login"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Login (Admin)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Admin login succeeds', function () { pm.response.to.have.status(200); });",
                      "const user = pm.response.json();",
                      "pm.collectionVariables.set('adminAccessToken', user.accessToken);",
                      "pm.collectionVariables.set('adminRefreshToken', user.refreshToken);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"password123\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{gatewayUrl}}/api/users/login",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "login"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Refresh Customer Access Token",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Access token refresh succeeds', function () { pm.response.to.have.status(200); });",
                      "const tokens = pm.response.json();",
                      "pm.collectionVariables.set('accessToken', tokens.accessToken);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{gatewayUrl}}/api/auth/refresh",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "refresh"
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Wallet operations",
          "item": [
            {
              "name": "Get My Wallet",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{gatewayUrl}}/api/wallets/{{walletId}}",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "wallets",
                    "{{walletId}}"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Deposit Money",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 100.00\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{gatewayUrl}}/api/wallets/{{walletId}}/deposit",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "wallets",
                    "{{walletId}}",
                    "deposit"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Withdraw Money",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": 10.00\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{gatewayUrl}}/api/wallets/{{walletId}}/withdraw",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "wallets",
                    "{{walletId}}",
                    "withdraw"
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Admin operations",
          "item": [
            {
              "name": "Get All Wallets",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Admin wallet list is returned', function () { pm.response.to.have.status(200); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminAccessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{gatewayUrl}}/api/admin/wallets",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "wallets"
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Session cleanup (run last)",
          "item": [
            {
              "name": "Logout Customer",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Customer logout succeeds', function () { pm.response.to.have.status(204); });",
                      "pm.collectionVariables.unset('accessToken');",
                      "pm.collectionVariables.unset('refreshToken');"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{gatewayUrl}}/api/users/logout",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "logout"
                  ]
                }
              },
              "response": []
            }
          ]
        }
      ],
      "description": "Owns Users, Wallets, Auth, Admin. Runs on http://localhost:8081 internally, but every request in this collection goes through the gateway at {{gatewayUrl}} instead."
    },
    {
      "name": "Transaction Service (via Gateway)",
      "item": [
        {
          "name": "Ledger-enabled transfer",
          "item": [
            {
              "name": "Transfer Money (creates debit and credit ledger entries)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Transfer is created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "const transaction = pm.response.json();",
                      "pm.expect(transaction.type).to.eql('TRANSFER');",
                      "pm.expect(transaction.status).to.eql('SUCCESS');",
                      "pm.expect(transaction.fromWalletId).to.eql(Number(pm.collectionVariables.get('walletId')));",
                      "pm.expect(transaction.toWalletId).to.eql(Number(pm.collectionVariables.get('otherWalletId')));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fromWalletId\": {{walletId}},\n  \"toWalletId\": {{otherWalletId}},\n  \"amount\": 10.00\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{gatewayUrl}}/api/transfers",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "transfers"
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Transaction history and ledger",
          "item": [
            {
              "name": "Get Transaction History (includes ledger entries)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Transaction history is returned', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "const page = pm.response.json();",
                      "pm.expect(page.content).to.be.an('array');",
                      "pm.expect(page.number).to.eql(0);",
                      "pm.expect(page.size).to.eql(10);",
                      "",
                      "if (page.content.length > 0) {",
                      "    pm.expect(page.content[0].ledgerEntries).to.be.an('array');",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{gatewayUrl}}/api/transactions/wallet/{{walletId}}?page=0&size=10",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "transactions",
                    "wallet",
                    "{{walletId}}"
                  ],
                  "query": [
                    {
                      "key": "page",
                      "value": "0"
                    },
                    {
                      "key": "size",
                      "value": "10"
                    }
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Get Filtered Transaction History (date and amount)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Filtered transaction history is returned', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "const page = pm.response.json();",
                      "pm.expect(page.content).to.be.an('array');",
                      "page.content.forEach(function (transaction) {",
                      "    pm.expect(Number(transaction.amount)).to.be.within(1, 10000);",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{gatewayUrl}}/api/transactions/wallet/{{walletId}}/filter?fromDate=2020-01-01T00:00:00&toDate=2030-01-01T23:59:59&minAmount=1&maxAmount=10000&page=0&size=10",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "transactions",
                    "wallet",
                    "{{walletId}}",
                    "filter"
                  ],
                  "query": [
                    {
                      "key": "fromDate",
                      "value": "2020-01-01T00:00:00"
                    },
                    {
                      "key": "toDate",
                      "value": "2030-01-01T23:59:59"
                    },
                    {
                      "key": "minAmount",
                      "value": "1"
                    },
                    {
                      "key": "maxAmount",
                      "value": "10000"
                    },
                    {
                      "key": "page",
                      "value": "0"
                    },
                    {
                      "key": "size",
                      "value": "10"
                    }
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Beneficiaries",
          "item": [
            {
              "name": "Create Beneficiary",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Beneficiary is created', function () {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "const beneficiary = pm.response.json();",
                      "pm.expect(beneficiary.beneficiaryWalletId).to.eql(Number(pm.collectionVariables.get('beneficiaryWalletId')));",
                      "pm.collectionVariables.set('beneficiaryId', String(beneficiary.id));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"beneficiaryWalletId\": {{beneficiaryWalletId}},\n  \"nickname\": \"Amit\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{gatewayUrl}}/api/beneficiaries",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "beneficiaries"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Get My Beneficiaries",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Beneficiary list is returned', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "pm.expect(pm.response.json()).to.be.an('array');"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{gatewayUrl}}/api/beneficiaries",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "beneficiaries"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Delete Created Beneficiary",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Beneficiary is deleted', function () {",
                      "    pm.response.to.have.status(204);",
                      "});",
                      "pm.collectionVariables.unset('beneficiaryId');"
                    ]
                  }
                }
              ],
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{gatewayUrl}}/api/beneficiaries/{{beneficiaryId}}",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "api",
                    "beneficiaries",
                    "{{beneficiaryId}}"
                  ]
                }
              },
              "response": []
            }
          ]
        }
      ],
      "description": "Owns Transfers, Transaction History, Beneficiaries. Runs on http://localhost:8082 internally, but every request in this collection goes through the gateway at {{gatewayUrl}} instead. Transaction history moved from /api/wallets/{id}/transactions to /api/transactions/wallet/{id} in Phase 7 to remove a path collision with account-service."
    },
